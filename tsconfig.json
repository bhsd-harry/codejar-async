{
	"compilerOptions": {
		"target": "ES2019",
		"lib": [
			"ESNext",
			"DOM"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"declaration": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"rootDir": "src",
		"outDir": "./dist"
	},
	"include": [
		"src/*.ts"
	]
}
